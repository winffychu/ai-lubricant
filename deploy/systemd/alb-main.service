# alb-main.service —— 数据服务（对外唯一入口）
#
# After=alb-node.service：控制面先行（切换铁律，避免主服务起来后控制面还在换）。
# EnvironmentFile 与 alb-node 同一份 shared/alb.env（APP_VERSION 全局一致）。
[Unit]
Description=Ai Lubricant 数据服务
After=network.target alb-node.service
Wants=alb-node.service

[Service]
Type=simple
WorkingDirectory=/opt/ai-lubricant/current
EnvironmentFile=/opt/ai-lubricant/shared/alb.env
ExecStart=/opt/ai-lubricant/current/venv/bin/python main.py
Restart=on-failure
RestartSec=5
ExecStartPost=/opt/ai-lubricant/shared/wait-health.sh 8001 /mcp/health 180

[Install]
WantedBy=multi-user.target
