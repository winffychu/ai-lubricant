# alb-upgrade.service —— 升级执行器（oneshot，由 .path 与 .timer 共同触发）
#
# ExecStart 先把 updater 脚本 cp 到 /tmp 再 bash 执行：翻 current 指针时
# checkout 替换的是仓库内的原件，跑的是拷贝（bash 增量读脚本，原件被换会读到
# 新文件的乱字节）。每次 tick 都从 current 重读最新脚本——新版脚本若写坏，
# 本轮已成功的升级不受影响，下一轮退化（timer 兜底 + 人工 git checkout 修复）。
[Unit]
Description=Ai Lubricant 服务端升级执行器
After=alb-node.service

[Service]
Type=oneshot
# current 是软链指向当前 release；脚本在 script/server_updater.sh
ExecStart=/bin/bash -c 'cp /opt/ai-lubricant/current/script/server_updater.sh /tmp/alb-upgr-$$.sh && bash /tmp/alb-upgr-$$.sh; rm -f /tmp/alb-upgr-$$.sh'
# 升级失败不重启（oneshot 失败 systemd 不会自动重试；marker 仍在，timer 下一轮兜）
SuccessExitStatus=0
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
