# alb-upgrade.path —— 监听升级标记文件，写入即触发执行器
#
# web 进程 clone 完成后原子写 /var/lib/alb/upgrade_target；这里 inotify 收到
# close_write 立即拉起 alb-upgrade.service。service 运行期间本 unit 抑制不重复
# 触发，期间再写入的新请求由 alb-upgrade.timer 30s 兜底。
[Unit]
Description=检测服务端升级标记文件（写入即触发）

[Path]
PathChanged=/var/lib/alb/upgrade_target
MakeDirectory=yes

[Install]
WantedBy=multi-user.target
