# alb-tunnel.service —— Tunnel Runtime（独立进程，唯一负责本机穿透子进程）
#
# 与主服务共享 mc_tunnel_* 表与 node_server，但生命周期完全独立。重启顺序在
# alb-node 之后（穿透的启停都经 node-server 控制面，见 docker-compose 注释）。
[Unit]
Description=Ai Lubricant Tunnel Runtime
After=network.target alb-node.service
Wants=alb-node.service

[Service]
Type=simple
WorkingDirectory=/opt/ai-lubricant/current
EnvironmentFile=/opt/ai-lubricant/shared/alb.env
ExecStart=/opt/ai-lubricant/current/venv/bin/python -m tunnel_server
Restart=on-failure
RestartSec=5
ExecStartPost=/opt/ai-lubricant/shared/wait-health.sh 8004 /ready 120

[Install]
WantedBy=multi-user.target
