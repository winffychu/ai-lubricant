# syntax=docker/dockerfile:1.7
#
# 创空间（托管 Dockerfile 平台）单容器镜像。
#
# 与 docker-compose 形态（根 Dockerfile + docker-compose.yml）的区别：
#   * 单容器自包含：PostgreSQL / Redis 由 apt 装进本镜像，不开独立容器。
#   * 无持久卷：容器内部路径持久（restart 保留），重建即清空，由入口脚本幂等自举。
#   * 进程自己绑 7860（平台约定端口），由 supervisord 托管 5 个 program。
#
# 用法（创空间按 deploy_schema.json 配置，sdk_type=docker、port=7860）：
#   平台构建时用本文件；管理员账号等运行时变量走平台的 environment_variables 注入：
#     AI_LUBRICANT_BOOTSTRAP_ADMIN_EMAIL / _PASSWORD（详见文件末尾说明）
#   本地验证：
#     docker build -f Dockerfile.codespace -t ai-lubricant-codespace .
#     docker run --rm -p 7860:7860 \
#       -e AI_LUBRICANT_BOOTSTRAP_ADMIN_EMAIL=you@example.com \
#       -e AI_LUBRICANT_BOOTSTRAP_ADMIN_PASSWORD='<强密码>' \
#       ai-lubricant-codespace
#
# Docker Hub 基础镜像前缀，供国内部署走加速器（空 = 直连 Docker Hub）。
ARG DOCKER_REGISTRY_PREFIX=
FROM ${DOCKER_REGISTRY_PREFIX}python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/usr/lib/postgresql/16/bin:${PATH}"

# supervisord（进程托管）；libpq5（PG 客户端运行时依赖）。
# PostgreSQL / Redis 走 apt 安装，而非 native_deps 下载：
#   * native_deps 的 Linux PG 二进制 URL（ftp.postgresql.org/.../linux-x64-binaries）
#     实际 404（EDB 不在此路径托管 Linux 包）；Redis 默认 URL 是源码 tarball（需编译）。
#   * native_deps.binaries.ensure_dep 先查 shutil.which("postgres"/"redis-server")，
#     命中即用 PATH 里的系统二进制，跳过下载。
# PGDG 仓库拿到 PG 16（与 compose 形态一致）。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        supervisor libpq5 ca-certificates tini gnupg curl lsb-release \
        redis-server \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16 \
    && rm -rf /var/lib/apt/lists/*

# 非 root 用户：PostgreSQL 拒绝以 root 运行 initdb / postgres。
RUN useradd --create-home --uid 1000 --shell /bin/bash app

WORKDIR /app

# 先装 Python 依赖（单独一层，改代码不必重装）。pip 以 root 跑，装进系统 site-packages。
COPY requirements.txt .
# 海外构建可 --build-arg PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install -r requirements.txt -i "${PIP_INDEX_URL}"

COPY --chown=app:app . .
# /app 目录本身归 app（COPY --chown 只管内容；provision 要往 /app/.env 写）。
RUN chown -R app:app /app

# ---- 构建期预备运行时目录 + 首次 initdb ----
# NATIVE_DEPS_ROOT 固定路径：容器内持久（restart 存活）、重建清空后重新 provision。
# provision 会：initdb 建 PG 集群、生成 Redis 配置、写 .env 连接键与三个共享密钥
# （全部幂等）。PG/Redis 二进制来自 PATH 里的 apt 安装，不再走下载。
ENV NATIVE_DEPS_ROOT=/opt/ailubricant/runtime \
    NATIVE_APP_ROOT=/app \
    DESKTOP_ENV_FILE=/app/.env \
    SERVER_PORT=7860 \
    NODE_CONTROL_HOST=127.0.0.1 \
    NODE_CONTROL_PORT=8003 \
    AGENT_COMPOSE_BASE_URL=http://127.0.0.1:8003 \
    AGENT_COMPOSE_NODE_SERVER_ENABLED=true \
    TUNNEL_RUNTIME_ENABLED=true \
    NATIVE_POSTGRES_PORT=15432 \
    NATIVE_REDIS_PORT=6479

# 一次性 provision（幂等）。以 app 用户运行：PG 拒绝 root 初始化。
RUN mkdir -p "${NATIVE_DEPS_ROOT}" && chown -R app:app "${NATIVE_DEPS_ROOT}" \
    && su app -c 'cd /app && python -m native_deps.cli provision' \
    && chown -R app:app "${NATIVE_DEPS_ROOT}" /app

# ---- PG unix socket 目录（非 root 运行必需）----
# PostgreSQL 启动时要在 socket 目录建锁文件 .s.PGSQL.<port>.lock。Debian/Ubuntu 的 PG
# 编译默认 unix_socket_directories=/var/run/postgresql，而该目录归 postgres 用户；本镜像
# 以 app(uid 1000) 运行 postgres，会 FATAL: could not create lock file ... Permission denied
# → PG 起不来 → main/node-server/tunnel-server 全部连库失败、对外 7860 无应答。
# 把 socket 目录改到 app 自有、随镜像层保留的 ${NATIVE_DEPS_ROOT}/run（不依赖 /run 的
# 挂载方式）；客户端一律走 TCP(127.0.0.1)，该目录仅用于锁文件/本地 socket。
RUN printf "\n# codespace overlay: writable socket dir for the non-root app user\nunix_socket_directories = '%s'\n" "${NATIVE_DEPS_ROOT}/run" \
        >> "${NATIVE_DEPS_ROOT}/data/postgres/postgresql.conf" \
    && install -d -o app -g app "${NATIVE_DEPS_ROOT}/run" \
    && chown app:app "${NATIVE_DEPS_ROOT}/data/postgres/postgresql.conf"

# ---- 管理员账号 ----
# 不在镜像里烘焙凭据：由平台在**运行时**注入环境变量（创空间的
# deploy_schema.json → environment_variables）：
#   AI_LUBRICANT_BOOTSTRAP_ADMIN_EMAIL / _PASSWORD / _NAME
# 应用启动时 user_platform.seed_bootstrap_admin 读它们播种（幂等）。
# 这里刻意不写 ENV 默认值——空的 ENV 会固化进镜像层，且与运行时注入的
# 同名变量语义重叠，徒增困惑。

# 入口脚本可执行（deploy/ 未被 .dockerignore 排除；script/ 被排除，不能引用它）。
RUN chmod +x /app/deploy/codespace/entrypoint.sh

# 对外只暴露 7860（数据服务）。8003/8004 仅容器内网。
EXPOSE 7860

USER app

# tini 收尸僵尸进程（supervisord 托管的 PG/Redis/python 子进程）。
ENTRYPOINT ["/usr/bin/tini", "--", "/app/deploy/codespace/entrypoint.sh"]
