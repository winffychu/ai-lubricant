# Ai Lubricant 环境变量模板
#
# 用法：cp .env.example .env 后，填写下面【必须设置】的键。
# 优先级铁律：环境变量 > .env > 内置默认值（详见 docs/ENV_VARS.md）。
# 本文件只列"没有合理默认值、必须由部署者决定"的键；带内置默认值的键统一放在
# 文件末尾的【可选】小节，全部注释态，按需取消注释。
# compose 部署额外说明见文件末尾【compose】。

# ════════ 必须设置 ════════

# ---- PostgreSQL ----
# compose 部署时主机名由 docker-compose.yml 固定为 postgres（服务名），此处无需改。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# ⚠ 与 docker-compose.yml 的内置默认一致（compose 未设时即用此值），因此改这里
#   必须同步改 compose 的 PG 容器，两边保持同值。生产部署请改为强密码。
POSTGRES_USER=ai_lubricant
POSTGRES_PASSWORD=ai_lubricant
POSTGRES_DATABASE=ai-lubricant

# ---- Redis ----
# 同上：compose 部署时主机名由 docker-compose.yml 固定为 redis（服务名）。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis key 前缀（运行态命名空间）。native 形态由 native_deps 自动写入。
REDIS_PREFIX_KEY=ai_lubricant
REDIS_DB=0
# 必须 true/false（布尔值），留空即启动失败。
REDIS_DECODE_RESPONSES=true
REDIS_MAX_CONNECTIONS=500

# ---- 三个共享密钥：必须在【容器创建前】填好 ----
# 容器创建时 docker-compose 就固化 env_file 的值，事后再填必须重建容器才生效。
# 多实例部署必须同值；单文件挂载下自动写回会因文件重命名报 EBUSY 而拒启。
# NODE_CONTROL_TOKEN —— main 与 node-server 共享的控制面 token。
#   生成：openssl rand -base64 32（或任意 32 字节随机串）
NODE_CONTROL_TOKEN=
# NODE_CREDENTIAL_ENCRYPTION_KEY —— 节点凭据 AES-256 加密 key，生成后不可轮换
#   （轮换会使已加密的节点凭据全部失效）。
#   生成：openssl rand -hex 32
NODE_CREDENTIAL_ENCRYPTION_KEY=
# AGENT_ATTACHMENT_SIGNING_KEY —— Agent 附件签名临时 URL 的 HMAC 密钥。
#   生成：openssl rand -base64 48
AGENT_ATTACHMENT_SIGNING_KEY=

# ---- 首启管理员（建议填写）----
# 留空应用能正常启动，但管理端没有账号可登录，需要另行初始化。
AI_LUBRICANT_BOOTSTRAP_ADMIN_EMAIL=
AI_LUBRICANT_BOOTSTRAP_ADMIN_PASSWORD=

# ---- 国内部署 ----
# 设 MIRROR_MODE=cn 后：节点镜像 build 的 alpine/apk/npm 三处海外源、以及节点运行时
# 安装/升级编辑器 CLI（claude/codex/gemini 等）的 npm 全走国内源。
# 注意：compose 的镜像拉取（postgres/redis/clickhouse 与主服务 FROM）走的是
# DOCKER_REGISTRY_PREFIX（见【可选】小节），compose 插值不认 MIRROR_MODE。
# 全部留空 = 直连海外。
MIRROR_MODE=cn

# ════════ 可选（均有内置默认值，按需启用）════════
# 取消注释即生效；值已填为该键的代码默认值。

# ---- 国内加速其余项 ----
# Docker Hub 镜像前缀（含结尾 /）。默认空 = 直连。国内部署设 MIRROR_MODE=cn 时一并启用。
# DOCKER_REGISTRY_PREFIX=
# npm 源。默认 https://registry.npmmirror.com
# NPM_REGISTRY=
# Alpine apk 镜像域名（路径结构与官方 CDN 一致）。默认 mirrors.aliyun.com
# APK_MIRROR=

# ---- 原生依赖下载代理（无 Docker 的 exe / supervisord / 单文件形态）----
# 仅当下载 PG/Redis/ClickHouse 二进制需要走代理时设置。
# NATIVE_DEPS_PROXY=http://<proxy-host>:<port>

# ---- 出站上游连接池（每个出站模式实例独立生效）----
# 默认 100；高并发打单一上游时按需调大。
# OUTBOUND_CONNECTOR_LIMIT=100
# 默认 32。
# OUTBOUND_CONNECTOR_LIMIT_PER_HOST=32

# ---- 连接池与超时 ----
# POSTGRES_POOL_MIN_SIZE=1
# POSTGRES_POOL_MAX_SIZE=10
# REDIS_STREAM_TIMEOUT=10
# REDIS_POOL_TIMEOUT=10

# ---- ClickHouse 请求 payload 双写（默认关闭）----
# 开启后完整请求/响应体入库 ClickHouse；还需 docker compose --profile clickhouse up -d。
# CLICKHOUSE_REQUEST_PAYLOAD_ENABLED=false
# CLICKHOUSE_ADDR=
# CLICKHOUSE_DATABASE=ai_lubricant_logs
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_REQUEST_PAYLOAD_TTL_DAYS=30
# CLICKHOUSE_MAX_PAYLOAD_BYTES=4194304

# ---- 局域网发现（手机 App 登录页 UDP 广播 -> 服务应答登录地址）----
# 详见 docs/lan-discovery.md。docker 部署时 compose 已自动设 LAN_DISCOVERY_HTTP_PORT。
# LAN_DISCOVERY_ENABLED=true
# LAN_DISCOVERY_PORT=58160
# LAN_DISCOVERY_HTTP_PORT=
# LAN_DISCOVERY_SERVER_NAME=Ai Lubricant
# LAN_DISCOVERY_ALLOW_LOOPBACK=false

# ---- 市场仓库 ----
# 仓库地址不配时用内置默认（wuxin-gh/ai-lubricant-marketplace）；token 不配时只读市场。
# MARKETPLACE_REPO_URL=
# MARKETPLACE_GITHUB_BRANCH=main
# MARKETPLACE_GITHUB_TOKEN=
# MARKETPLACE_MODULES=mcp,plugins,skills,channels,prompts,node-versions,mobile-versions,device-control-versions
# MARKETPLACE_INDEX_NAME=index.json

# ---- 消费方市场（留空回落生产仓库）----
# MARKETPLACE_CONSUMER_REPO_URL=
# MARKETPLACE_CONSUMER_GITHUB_BRANCH=main
# MARKETPLACE_CONSUMER_MODULES=mcp,plugins,skills,channels,prompts,node-versions,mobile-versions,device-control-versions
# MARKETPLACE_CONSUMER_INDEX_NAME=index.json

# ---- 程序发行独立仓库（GitHub Releases 存二进制，市场仓库只留元数据）----
# 三类程序各自推送到独立仓库的 Release（tag: node-v{版本} / mobile-v{版本} /
# device-control-v{版本}）。不配时用内置默认（wuxin-gh/ai-lubricant-nodes|mobile|
# device-control）；token 不配时回落 MARKETPLACE_GITHUB_TOKEN。
# NODE_RELEASE_REPO_URL=https://github.com/wuxin-gh/ai-lubricant-nodes
# NODE_RELEASE_GITHUB_TOKEN=
# MOBILE_RELEASE_REPO_URL=https://github.com/wuxin-gh/ai-lubricant-mobile
# MOBILE_RELEASE_GITHUB_TOKEN=
# DEVICE_CONTROL_RELEASE_REPO_URL=https://github.com/wuxin-gh/ai-lubricant-device-control
# DEVICE_CONTROL_RELEASE_GITHUB_TOKEN=

# ---- 兼容层 / 系统用户 ----
# 用户门户/console、节点页、团队等 C 端功能总开关。默认 true；
# 纯 API 网关部署（不用用户体系）显式设 false。
# AI_LUBRICANT_COMPAT_ENABLED=true
# AI_LUBRICANT_USER_ADAPTER_ENABLED=false
# AI_LUBRICANT_SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001
# AI_LUBRICANT_SYSTEM_USER_NAME=system
# AI_LUBRICANT_SYSTEM_USER_EMAIL=system@ai-lubricant.local
# AI_LUBRICANT_BOOTSTRAP_ADMIN_NAME=admin
# 主服务调 node-server 的地址。compose 部署无需设置（compose 已默认
# http://node-server:8003）；宿主机裸跑（应用直接 python main.py、只有中间件在别处）
# 才需要设 http://127.0.0.1:8003
# AGENT_COMPOSE_BASE_URL=http://node-server:8003
# AGENT_COMPOSE_TIMEOUT=30
# 节点远程接入时通告给节点的公网地址；留空 = 不设置。
# AGENT_COMPOSE_NODE_SERVER_PUBLIC_URL=

# ---- compose 端口 / 标签（仅 docker-compose.yml 使用）----
# 注意：上面的 POSTGRES_PORT / REDIS_PORT 在 compose 部署下只影响宿主调试端口映射，
# 服务内部固定连 postgres:5432 / redis:6379，无需修改。
# AI_LUBRICANT_HOST_PORT=3006      # 数据服务对外端口（管理端 /manager 与用户门户 /console）
# NODE_CONTROL_PUBLIC_PORT=8003    # 节点控制面对外端口
# TAG=local                        # 共享镜像 tag（ai-lubricant:<TAG>，三服务共用一次构建）
